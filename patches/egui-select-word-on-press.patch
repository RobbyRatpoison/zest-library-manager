-fn select_word_at(text: &str, ccursor: CCursor) -> CCursorRange {
+/// The selection that spans `anchor` (the word first picked) and the word under `pointer`:
+/// dragging after a double press grows the selection a whole word at a time, in either direction.
+pub(crate) fn extend_by_words(text: &str, anchor: CCursorRange, pointer: CCursor, by_line: bool) -> CCursorRange {
+    let a = anchor.as_sorted_char_range();
+    let w = select_unit_at(text, pointer, by_line).as_sorted_char_range();
+    if w.start < a.start {
+        CCursorRange { primary: CCursor::new(w.start), secondary: CCursor::new(a.end), h_pos: None }
+    } else {
+        CCursorRange::two(CCursor::new(a.start), CCursor::new(w.end.max(a.end)))
+    }
+}
+
+/// The word (or, for a triple press, the line) under `ccursor`.
+pub(crate) fn select_unit_at(text: &str, ccursor: CCursor, by_line: bool) -> CCursorRange {
+    if by_line { select_line_at(text, ccursor) } else { select_word_at(text, ccursor) }
+}
+
+pub(crate) fn select_word_at(text: &str, ccursor: CCursor) -> CCursorRange {
     if text.is_empty() {
         return CCursorRange::one(ccursor);
     }
